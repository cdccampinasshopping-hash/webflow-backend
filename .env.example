# Copie este arquivo para ".env" e preencha antes de rodar o servidor.

# Porta em que o servidor vai rodar
PORT=3000

# Chave secreta usada para assinar os tokens de login (JWT).
# IMPORTANTE: troque por um valor longo e aleatório antes de colocar em produção.
# Você pode gerar um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_essa_chave_secreta_antes_de_ir_pra_producao

# Endereço do seu site (landing page / painel) — usado para liberar o CORS.
# Coloque o domínio real quando publicar, ex: https://webflow.com.br
FRONTEND_ORIGIN=*

# (Opcional) Chave da Google Places API (New) — mostra nota, total e avaliações em destaque
# do Google no painel do lojista e no portfólio público. Sem ela, só aparece o que vem da placa.
GOOGLE_PLACES_API_KEY=

# (Opcional) Coloque 1 pra placa voltar a ir direto pro Google, sem a tela rápida de avaliação.
PLACA_DIRETO_GOOGLE=
