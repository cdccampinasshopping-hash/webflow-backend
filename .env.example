# Copie este arquivo para ".env" e preencha antes de rodar o servidor.

# Porta em que o servidor vai rodar
PORT=3000

# Chave secreta usada para assinar os tokens de login (JWT).
# IMPORTANTE: troque por um valor longo e aleatório antes de colocar em produção.
# Você pode gerar um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_essa_chave_secreta_antes_de_ir_pra_producao

# Endereço do seu site (landing page / painel) — usado para liberar o CORS.
# Coloque o domínio real quando publicar, ex: https://webflow.com.br
FRONTEND_ORIGIN=*

# (Opcional) Chave da Google Places API (New) — mostra nota, total e avaliações em destaque
# do Google no painel do lojista e no portfólio público. Sem ela, só aparece o que vem da placa.
GOOGLE_PLACES_API_KEY=

# (Opcional) Por padrão a placa vai direto pro Google. Coloque 0 pra mostrar antes a tela rápida
# de avaliação da loja (nota + comentário, que alimentam o mural do lojista).
PLACA_DIRETO_GOOGLE=

# (Opcional) Pra onde vão o backup diário e os avisos internos. Se vazio, usa o ADMIN_EMAIL.
# Enquanto o domínio não estiver verificado no Resend, só o e-mail dono da conta Resend recebe.
EMAIL_AVISOS=

# ---------- Agenda online + robô (barbearia, salão, clínica) ----------
# Endereço público deste backend (usado no link do Google e no calendário .ics)
BACKEND_URL=

# (Opcional) WhatsApp automático pela API oficial da Meta (WhatsApp Cloud API).
# Sem isso o painel mostra um botão que abre o WhatsApp com a confirmação pronta.
# Modelo de confirmação (categoria Utilidade), corpo com 6 variáveis, por exemplo:
#   Olá, {{1}}! Seu horário na {{2}} está confirmado: {{3}}, {{4}} às {{5}}. Pra ver ou desmarcar: {{6}}
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=confirmacao_agendamento
# Modelo de cancelamento (opcional), 4 variáveis: {{1}} nome, {{2}} loja, {{3}} dia, {{4}} hora
WHATSAPP_TEMPLATE_CANCELAMENTO=
# Aviso pro barbeiro/profissional (Utilidade), 6 variáveis, por exemplo:
#   Novo horário na agenda, {{1}}: {{2}} – {{3}}, {{4}} às {{5}}. WhatsApp do cliente: {{6}}
WHATSAPP_TEMPLATE_PROFISSIONAL=novo_agendamento_profissional
# Aviso de cancelamento pro barbeiro (opcional), 5 variáveis: {{1}} barbeiro, {{2}} cliente, {{3}} serviço, {{4}} dia, {{5}} hora
WHATSAPP_TEMPLATE_PROFISSIONAL_CANCELAMENTO=
WHATSAPP_IDIOMA=pt_BR

# (Opcional) Google Agenda do gestor: credencial OAuth (Aplicativo da Web) no Google Cloud,
# com a Google Calendar API ativada (é gratuita). O barbeiro com e-mail cadastrado na agenda
# entra como convidado em cada evento e o horário aparece no Google Agenda dele.
# URI de redirecionamento autorizado:
#   BACKEND_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
